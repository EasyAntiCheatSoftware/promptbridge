#!/bin/sh
# Resolve the installed link without changing any existing Claude command.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF") || exit 1
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT=$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd) || exit 1
PYTHON=${PROMPTBRIDGE_PYTHON:-python3}
if [ -z "${PROMPTBRIDGE_PYTHON:-}" ] && [ -f "$ROOT/runtime/python-path" ]; then
  IFS= read -r PYTHON < "$ROOT/runtime/python-path"
fi
exec "$PYTHON" "$ROOT/bridge.py" "$@"
